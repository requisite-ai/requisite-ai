# Copy this file to `.env` and fill in the keys for the provider(s) you use.
# You only need to set the key for the provider you actually intend to use --
# Settings (requisite/config/settings.py) reads whichever are present and
# leaves the rest as None.

# --- LLM provider API keys -------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Azure OpenAI needs both a key and your resource endpoint. Uses the current
# v1 GA API (base_url + api key only) -- no dated api-version string needed.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Ollama: only needed for Ollama Cloud or a proxied/authenticated deployment --
# a purely local server needs neither. Leave OLLAMA_HOST unset to use the
# ollama SDK's own default (http://localhost:11434, or its own OLLAMA_HOST
# resolution).
OLLAMA_API_KEY=
OLLAMA_HOST=

# Provider to use when AI() is constructed without an explicit `provider=`.
# One of: openai, anthropic, gemini, groq, azure_openai, openrouter, together, ollama
DEFAULT_PROVIDER=openai

# Default model / deployment name. Examples:
#   OpenAI:       gpt-4o-mini, gpt-4o
#   Anthropic:    claude-sonnet-4-6, claude-opus-4-8, claude-haiku-4-5
#   Gemini:       gemini-2.5-flash, gemini-2.5-pro
#   Groq:         llama-3.3-70b-versatile, openai/gpt-oss-20b
#   Azure OpenAI: your deployment name (e.g. gpt-4.1-nano), not the base model name
#   OpenRouter:   openai/gpt-4o-mini, anthropic/claude-sonnet-4-6 (vendor/model)
#   Together AI:  meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8 (namespaced)
#   Ollama:       llama3.2, qwen3 (must already be pulled on the target server)
MODEL=gpt-4o-mini

# Default sampling temperature (0.0 - 2.0).
TEMPERATURE=0.2

# Per-request timeout, in seconds.
REQUEST_TIMEOUT=60

# Retries for transient provider failures.
MAX_RETRIES=2

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Proactive rate limiting (opt-in -- unset means no limiting). Useful for
# free-tier quotas (e.g. Gemini's free tier: 15 requests/minute). When set,
# AI() built without an explicit rate_limiter= builds a private RateLimiter
# from this value. To share ONE budget across several Agent/AI instances
# (the usual case -- they likely call the same underlying API key), construct
# a requisite.core.rate_limiter.RateLimiter explicitly and pass it as
# rate_limiter= to each one instead of relying on this env var alone.
RATE_LIMIT_RPM=
# If waiting for capacity would exceed this many seconds, raise
# RateLimitException instead of waiting. Unset waits as long as necessary.
RATE_LIMIT_MAX_WAIT_SECONDS=

# ---------------------------------------------------------------------------
# RAG vector stores -- read by the vector store SDKs / your own application
# code, not by Settings (PineconeVectorStore/WeaviateVectorStore take these
# as constructor arguments; Settings has no vector-store-specific fields).
# ---------------------------------------------------------------------------

# Pinecone: the pinecone SDK itself reads PINECONE_API_KEY automatically if
# PineconeVectorStore(api_key=...) is omitted. There is no PINECONE_ENVIRONMENT
# anymore -- that was the older pinecone-client's concept; current serverless
# indexes are addressed by cloud/region (PineconeVectorStore(cloud=, region=)).
PINECONE_API_KEY=

# Weaviate: unlike Pinecone, the weaviate-client SDK does NOT read these
# automatically -- pass them explicitly, e.g.
# WeaviateVectorStore(url=os.environ["WEAVIATE_URL"], api_key=os.environ["WEAVIATE_API_KEY"]).
# Leave both unset to connect to a local instance (http://localhost:8080) instead.
WEAVIATE_URL=
WEAVIATE_API_KEY=

# ---------------------------------------------------------------------------
# Memory backends -- read by the backend itself, not by Settings.
# SQLiteMemory takes db_path as a required constructor argument (no env
# var -- a persistent backend shouldn't silently pick a file path).
# RedisMemory falls back to REDIS_URL if `url=` is omitted -- unlike the
# Pinecone/OpenAI SDKs, redis-py does not read this automatically, so
# RedisMemory implements the fallback itself. Leave unset to connect to a
# local Redis instance (redis://localhost:6379/0) instead.
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Planned integrations (see ROADMAP.md) -- not yet read by Settings.
# Placeholders reserved now so .env doesn't need restructuring when these
# land: capability resolvers (GitHub, Hugging Face), memory backends (AWS,
# Azure general-purpose storage).
# ---------------------------------------------------------------------------

# GitHub (planned "github" capability resolver / MCP server)
GITHUB_TOKEN=

# Hugging Face (planned model/dataset access, embeddings)
HUGGINGFACE_API_TOKEN=

# AWS credentials (planned: Bedrock provider, S3-backed memory, etc.)
# General-purpose, not tied to a single planned feature -- prefer a scoped
# IAM role/profile over long-lived keys where possible.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Azure credentials for non-OpenAI Azure services (planned: Azure-backed
# memory/storage, Microsoft Entra ID auth). Distinct from AZURE_OPENAI_*
# above, which is specifically for the Azure OpenAI provider.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
