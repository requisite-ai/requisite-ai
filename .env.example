# Copy this file to `.env` and fill in the keys for the provider(s) you use.
# You only need to set the key for the provider you actually intend to use --
# Settings (requisite/config/settings.py) reads whichever are present and
# leaves the rest as None.

# --- LLM provider API keys -------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Azure OpenAI needs both a key and your resource endpoint. Uses the current
# v1 GA API (base_url + api key only) -- no dated api-version string needed.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Provider to use when AI() is constructed without an explicit `provider=`.
# One of: openai, anthropic, gemini, groq, azure_openai
DEFAULT_PROVIDER=openai

# Default model / deployment name. Examples:
#   OpenAI:       gpt-4o-mini, gpt-4o
#   Anthropic:    claude-sonnet-4-6, claude-opus-4-8, claude-haiku-4-5
#   Gemini:       gemini-2.5-flash, gemini-2.5-pro
#   Groq:         llama-3.3-70b-versatile, openai/gpt-oss-20b
#   Azure OpenAI: your deployment name (e.g. gpt-4.1-nano), not the base model name
MODEL=gpt-4o-mini

# Default sampling temperature (0.0 - 2.0).
TEMPERATURE=0.2

# Per-request timeout, in seconds.
REQUEST_TIMEOUT=60

# Retries for transient provider failures.
MAX_RETRIES=2

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Planned integrations (see ROADMAP.md) -- not yet read by Settings.
# Placeholders reserved now so .env doesn't need restructuring when these
# land: capability resolvers (GitHub, Hugging Face), memory backends (AWS,
# Azure general-purpose storage), and RAG vector stores (Pinecone, Weaviate).
# ---------------------------------------------------------------------------

# GitHub (planned "github" capability resolver / MCP server)
GITHUB_TOKEN=

# Hugging Face (planned model/dataset access, embeddings)
HUGGINGFACE_API_TOKEN=

# AWS credentials (planned: Bedrock provider, S3-backed memory, etc.)
# General-purpose, not tied to a single planned feature -- prefer a scoped
# IAM role/profile over long-lived keys where possible.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Azure credentials for non-OpenAI Azure services (planned: Azure-backed
# memory/storage, Microsoft Entra ID auth). Distinct from AZURE_OPENAI_*
# above, which is specifically for the Azure OpenAI provider.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Pinecone (planned vector store for RAG)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Weaviate (planned vector store for RAG)
WEAVIATE_URL=
WEAVIATE_API_KEY=
